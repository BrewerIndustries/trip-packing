# Where the SQLite file lives (optional; defaults to ./data/packing.db).
# Each environment has its own DB, so dev + prod never share data.
# PACKING_DB_PATH=/opt/trip-packing/data/packing.db

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod.
# JARVIS_ENV=dev
